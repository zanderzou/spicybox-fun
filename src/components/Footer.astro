---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
interface Props { posts: CollectionEntry<"blog">[]; }
const { posts } = Astro.props;
---
<footer><div class="footer-grid">
  <div><a class="brand" href="/"><span class="brand-icon">SB</span><strong>Spicy<span>Box</span></strong><small>INDEPENDENT GUIDE</small></a><p>Independent research on the SpicyBox adult image-to-video generator, templates, credits, uploads, privacy, consent, safety, and alternatives.</p></div>
  <div><h3>Explore</h3><a href="/#features">SpicyBox features</a><a href="/#compare">Generator comparisons</a><a href="/#privacy">Upload privacy</a><a href={site.officialUrl} rel="noopener" target="_blank">Official SpicyBox <Icon name="arrow" /></a></div>
  <div><h3>Latest guides</h3>{posts.slice(0,3).map((post)=><a href={`/blog/${post.id}/`}>{post.data.title}</a>)}</div>
  <div><h3>Information</h3><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a></div>
</div><div class="footer-bottom"><span>© <span data-year>2026</span> SpicyBox Guide</span><span>Independent · Not affiliated with SpicyBox</span><span>18+ editorial · No uploads collected</span></div></footer>
