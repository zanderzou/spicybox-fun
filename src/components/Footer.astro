---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { comparisons, routeFor, ui, type Locale } from "../data/locales";
interface Props { posts: CollectionEntry<"blog">[]; locale?: Locale; }
const { posts, locale } = Astro.props;
const label = locale ? ui[locale] : null;
const home = routeFor(locale || "");
const blog = routeFor(locale || "", "blog");
const links = locale ? comparisons.slice(0,3).map((entry) => ({
  href: routeFor(locale, `blog/${entry.slug}`),
  text: `SpicyBox vs ${entry.name}`
})) : posts.slice(0,3).map((post) => ({
  href: `/blog/${post.id}/`, text: post.data.title
}));
---
<footer><div class="footer-grid">
  <div><a class="brand" href={home}><span class="brand-icon">SB</span><strong>Spicy<span>Box</span></strong></a><p>{label ? `${label.independent} ${label.selfImage}` : "Independent research on the SpicyBox adult image-to-video generator, templates, credits, uploads, privacy, consent, safety, and alternatives."}</p></div>
  <div><h3>{label?.features || "Explore"}</h3><a href={`${home}#overview`}>{label?.features || "SpicyBox features"}</a><a href={`${home}#compare`}>{label?.compare || "Generator comparisons"}</a><a href={`${home}#privacy`}>{label?.privacy || "Upload privacy"}</a><a href={site.officialUrl} rel="noopener" target="_blank">{label?.official || "Official SpicyBox"} <Icon name="arrow" /></a></div>
  <div><h3>{label?.blog || "Latest guides"}</h3>{links.map((entry) => <a href={entry.href}>{entry.text}</a>)}<a href={blog}>{label?.allArticles || "All comparisons"}</a></div>
  <div><h3>{label?.about || "Information"}</h3><a href={routeFor(locale || "", "about")}>{label?.about || "About"}</a><a href={routeFor(locale || "", "privacy")}>{label?.privacy || "Privacy"}</a><a href={routeFor(locale || "", "terms")}>{label?.terms || "Terms"}</a><a href={routeFor(locale || "", "editorial-policy")}>{label?.editorial || "Editorial policy"}</a><a href={routeFor(locale || "", "contact")}>{label?.contact || "Contact"}</a></div>
</div><div class="footer-bottom"><span>© <span data-year>2026</span> SpicyBox</span><span>{label?.independent || "Independent · Not affiliated with SpicyBox"}</span><span>{label?.selfImage || "18+ editorial · No uploads collected"}</span></div></footer>
