---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"SpicyBox VS comparisons",url:`${site.url}/blog/`,description:"Five focused SpicyBox comparison guides covering features, strengths, weaknesses, cost, privacy, and best fit.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="SpicyBox Comparisons: Five Detailed VS Guides" description="Compare SpicyBox with Promptchan, OurDream AI, Playbox AI, Musebox AI, Runway using practical strengths, weaknesses, privacy, cost, and workflow tests." keywords={["SpicyBox AI comparison","SpicyBox AI vs","SpicyBox AI alternatives","best SpicyBox AI alternative"]} jsonLd={jsonLd}>
  <section class="page-hero"><div class="ambient-orb"></div><span>SPICYBOX COMPARISON LIBRARY</span><h1>Five useful VS guides.<br />One repeatable test.</h1><p>Detailed SpicyBox AI comparisons focused on real differences, advantages, disadvantages, cost, privacy, and the user each product suits.</p></section>
  <section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
