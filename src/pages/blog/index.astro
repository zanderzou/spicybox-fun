---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"SpicyBox comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent SpicyBox AI video generator comparisons, upload safety checklists, privacy research, and alternatives.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="SpicyBox Blog: Reviews, Comparisons & Safety" description="Independent SpicyBox guides covering AI image-to-video, templates, upload privacy, consent, credits, Promptchan, OurDream AI, and alternatives." keywords={["SpicyBox blog","SpicyBox review","SpicyBox comparison","AI video generator alternatives","is SpicyBox safe"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>SPICYBOX STUDIO NOTES</span><h1>Fast answers.<br/>Clear boundaries.</h1><p>Original, source-led guides to SpicyBox and the wider adult AI image and video category.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
