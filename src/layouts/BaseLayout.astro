---
import Analytics from "../components/Analytics.astro";
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { languageAlternates, locales, type Locale } from "../data/locales";
import "../styles.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  keywords?: string[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}
const { title, description, type = "website", keywords = [], noindex = false,
  publishedTime, modifiedTime, jsonLd, locale } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const image = `${site.url}/assets/spicybox-user-studio-character.png`;
const posts = (await getCollection("blog")).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const robots = noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const lang = locale ? locales.find((item) => item.slug === locale)!.lang : "en";
const ogLocales: Record<string,string> = {
  ja:"ja_JP", ko:"ko_KR", "zh-hant":"zh_TW", es:"es_ES", "pt-br":"pt_BR",
  ru:"ru_RU", de:"de_DE", fr:"fr_FR", ar:"ar_AR"
};
const ogLocale = locale ? ogLocales[locale] : "en_US";
const skipLabels: Record<Locale,string> = {
  ja: "本文へ移動", ko: "본문으로 건너뛰기", "zh-hant": "跳至主要內容",
  es: "Saltar al contenido", "pt-br": "Ir para o conteúdo",
  ru: "Перейти к содержимому", de: "Zum Inhalt springen",
  fr: "Aller au contenu", ar: "انتقل إلى المحتوى"
};
---
<!doctype html>
<html lang={lang} dir={locale === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta name="msvalidate.01" content="56B74B6B9E884918F4F18C05D7E2A1F4" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <link rel="canonical" href={canonical} />
    {!noindex && languageAlternates(Astro.url.pathname).map((entry) =>
      <link rel="alternate" hreflang={entry.lang} href={new URL(entry.href, site.url).toString()} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(languageAlternates(Astro.url.pathname)[0].href, site.url).toString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#070407" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Independent SpicyBox guide with adult, non-explicit editorial artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{locale ? skipLabels[locale] : "Skip to content"}</a>
    <Header locale={locale} noindex={noindex} />
    <main id="main"><slot /></main>
    <Footer posts={posts} locale={locale} />
    <script is:inline src="/assets/main.js"></script>
    <Analytics locale={locale} />
  </body>
</html>
